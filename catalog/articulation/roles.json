        {"suffix": "Barrel", "motion": "elevation", "axis": "y", "kind": "revolute", "limits": [0, 0],
         "pivot": "the trunnion (same point as the cradle)", "neutral": "level",
         "holds": "the barrel only; its tip is the muzzle (fixed in the model, the simulation's gun actuator)"}
