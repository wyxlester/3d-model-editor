{
  "schema": "me3d.articulation_roles/1",
  "doc": "Moving components and the joint chain each needs (contract §3b). Read by the server (research, plan and build checks) and by blender/common.py add_chain. Simulator-neutral: motion, axis, pivot, neutral pose, nesting. Each joint nests under the one before it. Axes are in the editor frame (+X bow/forward, +Y port/left, +Z up). Limits are degrees for revolute joints and metres for prismatic ones, in the motion's own sense (elevation: up is positive). `kinds` are the MAK profile kinds (mak/pipeline/profiles.py); `evidence.mak` is checked against the VR-Forces install by mak/tests/test_roles.py.",
  "kinds_for_project": {"ship": ["surface_ship"]},
  "roles": [
    {
      "id": "gun_mount",
      "example": "Weapons__Phalanx_1",
      "label": "Trainable gun (CIWS, autocannon, gun turret)",
      "kinds": ["surface_ship", "ground_vehicle", "fixed_wing", "rotary_wing"],
      "match": ["ciws", "phalanx", "goalkeeper", "autocannon", "gun turret", "machine gun", "bushmaster"],
      "group": "Weapons",
      "joints": [
        {"suffix": "", "motion": "azimuth", "axis": "z", "kind": "revolute", "limits": [-180, 180],
         "pivot": "centre of the training ring, on the deck", "neutral": "facing forward",
         "holds": "the base, housing and everything that trains"},
        {"suffix": "Gun", "motion": "elevation", "axis": "y", "kind": "revolute", "limits": [-20, 85],
         "pivot": "the trunnion: the barrel's elevation axis", "neutral": "barrel level, pointing forward",
         "holds": "the barrel, cradle and everything that pitches with it; its tip is the muzzle"}
      ],
      "evidence": {"mak": {"sysdef": "weapons/phalanx-20mm-gun.sysdef", "codes": [4096, 4416]},
                   "manual": ["AddContentToMAK 21.4", "AddContentToMAK 21.5.1", "UG 73.3.1"]}
    },
    {
